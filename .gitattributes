# Everything that runs on the handheld goes through busybox sh, which rejects CRLF with
# ": not found". The index is LF already; these rules keep a Windows checkout (core.autocrlf)
# from ever committing CRLF into a file the device reads.
*.sh                         text eol=lf
static/.tmp_update/updater   text eol=lf
Makefile                     text eol=lf
*.mk                         text eol=lf
*.ftl                        text eol=lf
*.toml                       text eol=lf
Cargo.lock                   text eol=lf
*.cfg                        text eol=lf
*.rmp                        text eol=lf
*.opt                        text eol=lf
*.info                       text eol=lf
*.json                       text eol=lf
*.yml                        text eol=lf
*.yaml                       text eol=lf
# Applied with `patch` inside the RetroArch build; a CRLF hunk would not match
*.patch                      text eol=lf
# Hashed by scripts/fonts/bdf_to_rust.py into the generated table's header
*.bdf                        text eol=lf

# Never normalise binaries, some of which ship without an extension
*.so   -text
*.ko   -text
*.png  -text
*.jpg  -text
*.gif  -text
*.ttf  -text
*.otf  -text
*.zip  -text
*.db   -text
